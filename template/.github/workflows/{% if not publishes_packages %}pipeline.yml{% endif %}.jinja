{% if ci_strategy == 'cloud' %}{% raw %}name: pipeline

# Mounts the verbs on the two occasions of an app repo (§§ 2 and 8
# PLX-Delivery), cloud strategy. A pull request asks "is the repo sound", a
# push to an environment branch asks "may this ship"; _pipeline-cloud.yml
# answers both for the whole repo and run: plan (the build and test hashes,
# one throwaway cloud instance per image to build and per test to run),
# check (lint, typecheck and the pure tests through the Turbo remote cache),
# build and test on the instances, release to the registry on an environment
# branch, deploy where the platform repo's inventory places each app, and
# teardown. A decision comes from a content hash, never from a diff: the
# same inputs are built once and tested once, and a promotion never builds.
# Run it by hand on an environment branch to deploy that branch again.
# Managed by copier: edit the preset (plexus-ms/preset-repo-web), never this
# file.
#
# One secret, OP_SERVICE_ACCOUNT_TOKEN, the CI vault's service account
# token; the cloud keys, the object-storage keys, the GitHub App, the deploy
# key and the apps' build-time keys are read from the vault <owner>-ci (§ 3
# PLX-Secrets). The repo variable DEPLOY_OVERLAY, `netbird` when the app
# hosts are reached over the tenant's overlay, lets the deploy job join it as
# an ephemeral peer; unset, the hosts are reached as named.

on:
  pull_request:
    paths-ignore: ['**/*.md']
  # No paths filter on pushes: a branch created at a commit the repo already
  # knows counts as a push of no files and would start nothing, and the hashes
  # make a Markdown-only push cheap.
  push:
    branches: [main, develop]
  workflow_dispatch:

permissions:
  contents: read
  packages: write
  actions: read

jobs:
  pipeline:
    uses: plexus-ms/primitives/.github/workflows/_pipeline-cloud.yml@0.107.0
    with:
      tenant: {% endraw %}{{ tenant }}{% raw %}
      overlay: ${{ vars.DEPLOY_OVERLAY || '' }}
      alerts-email: '{% endraw %}{{ alerts_email }}{% raw %}'
    secrets:
      op-service-account-token: ${{ secrets.OP_SERVICE_ACCOUNT_TOKEN }}
{% endraw %}
{% else %}{% raw %}name: pipeline

# Mounts the verbs on the two occasions of an app repo (§§ 2 and 3
# PLX-Delivery). A pull request asks "is the repo sound", and `verify`
# answers it repo-wide, tested as the merge result. A push to an environment
# branch asks "may this ship", per app: `changed-apps` emits the apps whose
# sources changed, and `app` fans the per-app pipeline (verify → release →
# deploy) over exactly those; a shared-package change redeploys its
# dependents, and an app whose image for the commit is already in the
# registry is deployed without being built again, which is what a promotion
# of `main` to a `develop` tip built there amounts to. Deploying needs a host:
# `main` deploys to DEPLOY_HOST, `develop` releases and stops until a staging
# host exists. A push to any other branch starts nothing until it has a pull
# request, and a change to nothing but Markdown starts nothing at all.
# Run it by hand on an environment branch to deploy that branch again.
# Managed by copier: edit the preset (plexus-ms/preset-repo-web), never this
# file.

on:
  pull_request:
    paths-ignore: ['**/*.md']
  push:
    branches: [main, develop]
    paths-ignore: ['**/*.md']
  workflow_dispatch:

permissions:
  contents: read
  packages: write

# Where the jobs run (repo variables): CI_RUNNER is the runner label, unset
# for GitHub's runners; CI_RUNNER_PERSISTENT is `true` when that runner keeps
# its disk between jobs, so caches stay local. Unset both to be back on
# GitHub's runners with the next push.
#
# Turbo's remote cache (§ 8 PLX-Delivery), off until TURBO_CACHE_BUCKET is
# set: the repo variables TURBO_CACHE_ENDPOINT, TURBO_CACHE_REGION and
# TURBO_CACHE_BUCKET name an S3 bucket of the tenant's own, the repo secrets
# TURBO_CACHE_ACCESS_KEY and TURBO_CACHE_SECRET_KEY grant read and write on it.
jobs:
  verify:
    # Pull requests, and a run by hand on a branch that names no environment.
    if: ${{ github.event_name == 'pull_request' || (github.ref != 'refs/heads/main' && github.ref != 'refs/heads/develop') }}
    # One run per pull request: a newer push cancels the verify still going
    # for the older commit, whose verdict nobody waits for any more.
    concurrency:
      group: verify-${{ github.ref }}
      cancel-in-progress: true
    uses: plexus-ms/primitives/.github/workflows/_verify.yml@0.107.0
    with:
      runner: ${{ vars.CI_RUNNER || 'ubuntu-latest' }}
      persistent: ${{ vars.CI_RUNNER_PERSISTENT == 'true' }}
      turbo-cache-endpoint: ${{ vars.TURBO_CACHE_ENDPOINT || '' }}
      turbo-cache-region: ${{ vars.TURBO_CACHE_REGION || '' }}
      turbo-cache-bucket: ${{ vars.TURBO_CACHE_BUCKET || '' }}
    secrets:
      turbo-cache-access-key: ${{ secrets.TURBO_CACHE_ACCESS_KEY }}
      turbo-cache-secret-key: ${{ secrets.TURBO_CACHE_SECRET_KEY }}

  changed-apps:
    if: ${{ github.event_name != 'pull_request' && (github.ref == 'refs/heads/main' || github.ref == 'refs/heads/develop') }}
    uses: plexus-ms/primitives/.github/workflows/_changed-apps.yml@0.107.0
    with:
      runner: ${{ vars.CI_RUNNER || 'ubuntu-latest' }}

  # Superseded runs are cancelled inside _pipeline.yml, per app and at the
  # verify job only, never here: cancelling this job would cancel a deploy in
  # flight.
  app:
    needs: changed-apps
    # Empty matrix is an error, not a no-op — skip the job when nothing changed.
    if: ${{ needs.changed-apps.outputs.apps != '[]' }}
    strategy:
      fail-fast: false
      matrix:
        app: ${{ fromJSON(needs.changed-apps.outputs.apps) }}
    uses: plexus-ms/primitives/.github/workflows/_pipeline.yml@0.107.0
    with:
      tenant: {% endraw %}{{ tenant }}{% raw %}
      app: ${{ matrix.app }}
      deploy: ${{ github.ref == 'refs/heads/main' }}
      host: ${{ vars.DEPLOY_HOST }}
      runner: ${{ vars.CI_RUNNER || 'ubuntu-latest' }}
      persistent: ${{ vars.CI_RUNNER_PERSISTENT == 'true' }}
      turbo-cache-endpoint: ${{ vars.TURBO_CACHE_ENDPOINT || '' }}
      turbo-cache-region: ${{ vars.TURBO_CACHE_REGION || '' }}
      turbo-cache-bucket: ${{ vars.TURBO_CACHE_BUCKET || '' }}
    secrets:
      ssh-key: ${{ secrets.DEPLOY_SSH_KEY }}
      turbo-cache-access-key: ${{ secrets.TURBO_CACHE_ACCESS_KEY }}
      turbo-cache-secret-key: ${{ secrets.TURBO_CACHE_SECRET_KEY }}
{% endraw %}
{% endif %}
