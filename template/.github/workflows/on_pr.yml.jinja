{% if publishes_packages %}{% raw %}name: on_pr

# A pull request asks "is the repo sound" (§ 2 PLX-Delivery), tested as the
# merge result: `check`, which for a package repo is the whole contract verb.
# Managed by copier: edit the preset (plexus-ms/preset-repo-turbo), never this
# file.
#
# A package repo's trunk admits nothing but pull requests, so this runs on
# every pull request; a push trigger would never fire for the "version
# packages" PR, whose branch the publish job pushes with the workflow token.
# Plus the changeset guard: a publishable change ships with a changeset, or
# an empty one that records a no-release change (`changeset add --empty`);
# the update bot's branches get theirs written by `plx changeset` instead.
#
# Where the jobs run is this repo's answer `ci_strategy` (§ 8 PLX-Delivery):
# {% endraw %}{{ ci_strategy }}{% raw %}. The repo variable CI_STRATEGY overrides it without a commit;
# `github` there is the way back to the forge's runners while a runner host
# is down.

on:
  pull_request:

permissions:
  contents: read

concurrency:
  group: on_pr-${{ github.ref }}
  cancel-in-progress: true

jobs:
  check:
    uses: plexus-ms/primitives/.github/workflows/_check.yml@0.118.0
    with:
      strategy: ${{ vars.CI_STRATEGY || '{% endraw %}{{ ci_strategy }}{% raw %}' }}
      tasks: verify

  changeset-status:
    # The Version Packages branch is *built by* `changeset version`, which
    # consumes the changeset files it releases — there "changed packages, no
    # changesets" is the expected state. The update bot's branches are exempt
    # because the guard counts any file under a package directory: a
    # devDependency bump trips it and owes no release; the changeset job below
    # writes the one a runtime bump owes.
    if: ${{ !startsWith(github.head_ref, 'changeset-release/') && !startsWith(github.head_ref, 'renovate/') }}
    runs-on: ${{ (vars.CI_STRATEGY || '{% endraw %}{{ ci_strategy }}{% raw %}') == 'github' && 'ubuntu-latest' || 'ci-small' }}
    steps:
      - uses: actions/checkout@v7
        with:
          fetch-depth: 0
      - uses: jdx/mise-action@v5
      - run: pnpm install --frozen-lockfile
      - run: pnpm exec changeset status --since=origin/main

  changeset:
    # The update bot writes no changesets: the verb writes the one its bump
    # owes and commits it to the bot's branch, pushed with a token minted for
    # the tenant's own GitHub App (contents write on this repo; repo variable
    # PLX_APP_ID, secret PLX_APP_PRIVATE_KEY) so that the new tip
    # runs this workflow; a push with the workflow token starts no run.
    if: ${{ startsWith(github.head_ref, 'renovate/') }}
    uses: plexus-ms/primitives/.github/workflows/_changeset.yml@0.118.0
    permissions:
      contents: write
    with:
      app_id: ${{ vars.PLX_APP_ID }}
      strategy: ${{ vars.CI_STRATEGY || '{% endraw %}{{ ci_strategy }}{% raw %}' }}
    secrets:
      app_private_key: ${{ secrets.PLX_APP_PRIVATE_KEY }}
{% endraw %}{% else %}{% raw %}name: on_pr

# A pull request asks "is the repo sound" (§ 2 PLX-Delivery), tested as the
# merge result: `check` (lint, typecheck and the pure tests), and behind it
# `verify`: every app's image is built and tested, from content hashes, so
# what the registry already holds is neither built nor tested again. Nothing
# is published or deployed. A change to nothing but Markdown starts nothing.
# Managed by copier: edit the preset (plexus-ms/preset-repo-turbo), never this
# file.
#
# One secret, OP_SERVICE_ACCOUNT_TOKEN, the CI vault's service account token;
# everything else is read from the vault <owner>-ci (§ 3 PLX-Secrets).
#
# Where the jobs run is this repo's answer `ci_strategy` (§ 8 PLX-Delivery):
# {% endraw %}{{ ci_strategy }}{% raw %}. The repo variable CI_STRATEGY overrides it without a commit;
# `github` there is the way back to the forge's runners while a runner host
# is down.
# The candidates live in `ci_registry`: {% endraw %}{{ ci_registry }}{% raw %}.

on:
  pull_request:
    paths-ignore: ['**/*.md']

permissions:
  contents: read
  packages: write
  actions: read

# A newer push to the pull request cancels the run still going for the older
# commit, whose verdict nobody waits for any more.
concurrency:
  group: on_pr-${{ github.ref }}
  cancel-in-progress: true

jobs:
  check:
    uses: plexus-ms/primitives/.github/workflows/_check.yml@0.118.0
    with:
      strategy: ${{ vars.CI_STRATEGY || '{% endraw %}{{ ci_strategy }}{% raw %}' }}
      turbo-cache: {% endraw %}{{ 'true' if ci_registry == 'own' else 'false' }}{% raw %}
    secrets:
      op-service-account-token: ${{ secrets.OP_SERVICE_ACCOUNT_TOKEN }}

  verify:
    needs: check
    uses: plexus-ms/primitives/.github/workflows/_verify.yml@0.118.0
    with:
      strategy: ${{ vars.CI_STRATEGY || '{% endraw %}{{ ci_strategy }}{% raw %}' }}
      registry: {% endraw %}{{ ci_registry }}{% raw %}
      alerts-email: '{% endraw %}{{ alerts_email }}{% raw %}'
    secrets:
      op-service-account-token: ${{ secrets.OP_SERVICE_ACCOUNT_TOKEN }}
{% endraw %}{% endif %}